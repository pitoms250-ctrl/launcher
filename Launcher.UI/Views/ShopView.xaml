<UserControl x:Class="Launcher.UI.Views.ShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Brush.TextPrimary}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="0,0,0,14" Padding="20,18" CornerRadius="14"
                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#193D2D" Offset="0" />
                    <GradientStop Color="#10251D" Offset="0.55" />
                    <GradientStop Color="#18251F" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="F LAUNCHER  /  STORE" Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Accent400}" FontWeight="Bold" />
                    <TextBlock Text="Магазин" Style="{StaticResource Text.H1}" Margin="0,5,0,0" />
                    <TextBlock Text="Косметика, наборы и возможности для игрового профиля"
                               Style="{StaticResource Text.Small}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Accent400}"
                                 VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding ShopStatus}" Style="{StaticResource Text.Caption}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <Border Padding="14,10" CornerRadius="10" Background="#33000000"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Brush.Accent600}"
                                    Margin="0,0,10,0">
                                <TextBlock Text="FL" FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Баланс" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding WalletCoins, StringFormat={}{0:N0} FL}"
                                           FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding NavigateCommand}"
                            CommandParameter="Shop" Margin="0,8,0,0" MinWidth="142" ToolTip="Обновить каталог">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" Margin="0,0,7,0" />
                            <TextBlock Text="Обновить каталог" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card.Glass}" Padding="12,9" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource Brush.SurfaceActive}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,10,0">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE719;" Foreground="{DynamicResource Brush.Accent400}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding ShopStatus}" TextWrapping="Wrap" Style="{StaticResource Text.Small}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ProgressBar Grid.Row="1" Style="{StaticResource ProgressBar.Themed}" Height="3" MinHeight="3"
                             Margin="0,8,0,0" IsIndeterminate="{Binding IsShopBusy}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox Style="{StaticResource TextBox.Themed}" Width="240" HorizontalAlignment="Left"
                     Tag="Поиск товаров" Text="{Binding ShopSearch, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="1" Width="170" Style="{StaticResource ComboBox.Themed}"
                      SelectedIndex="{Binding ShopSortIndex}" ToolTip="Сортировка каталога">
                <ComboBoxItem Content="По умолчанию" />
                <ComboBoxItem Content="Цена: сначала дешевле" />
                <ComboBoxItem Content="Цена: сначала дороже" />
                <ComboBoxItem Content="Редкость" />
                <ComboBoxItem Content="Популярность" />
            </ComboBox>
            <ListBox Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource ListBox.Themed}"
                     ItemContainerStyle="{StaticResource ListBoxItem.Themed}" ItemsSource="{Binding ShopCurrencies}"
                     SelectedItem="{Binding SelectedShopCurrency, Mode=TwoWay}" ToolTip="Валюта отображения">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>
            <ListBox Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" MaxHeight="66"
                     Style="{StaticResource ListBox.Themed}" ItemContainerStyle="{StaticResource ListBoxItem.Themed}"
                     ItemsSource="{Binding ShopCategories}" SelectedValuePath="Id"
                     SelectedValue="{Binding SelectedShopCategory, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding VisibleShopItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card.Glass}" Width="270" MinHeight="270"
                                    Margin="0,0,12,12" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="92" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource Brush.Bg1}" BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1" CornerRadius="12" Grid.Row="0" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="&#xE7C1;" FontFamily="{StaticResource IconFont}" FontSize="38"
                                                   Foreground="{DynamicResource Brush.Accent400}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding IconUrl}" Stretch="Uniform" MaxWidth="76" MaxHeight="76"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,3"
                                                CornerRadius="10" BorderThickness="1" Background="{DynamicResource Brush.Bg1}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#9CA3AF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Rarity}" Value="rare"><Setter Property="BorderBrush" Value="#38BDF8" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Rarity}" Value="epic"><Setter Property="BorderBrush" Value="#A855F7" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Rarity}" Value="legendary"><Setter Property="BorderBrush" Value="#F59E0B" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Rarity}" Style="{StaticResource Text.Caption}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource Text.H3}"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42" Margin="8,10,8,2" />
                                <TextBlock Grid.Row="2" Text="{Binding Description}" Style="{StaticResource Text.Small}"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="8,0,8,0" />

                                <StackPanel Grid.Row="3" Margin="8,8,8,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="tag">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Ник для уникального тега" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource TextBox.Themed}" Height="34" MinHeight="34" Padding="10,5"
                                             MaxLength="16" Tag="3–16 символов: латиница, цифры, _"
                                             Text="{Binding DataContext.RequestedTag, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <Grid Grid.Row="4" Margin="8,10,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent400}">
                                            <Run Text="{Binding PriceUah, StringFormat={}{0:0.00}}" /><Run Text=" ₴" />
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding DataContext.SelectedShopCurrency, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="UAH"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding PriceUsdt, StringFormat={}{0:0.00} USDT}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Accent400}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding DataContext.SelectedShopCurrency, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="USDT"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding PriceCoins, StringFormat={}{0:0} FL}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Accent400}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.SelectedShopCurrency, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="FL">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="FL Coins не доступны">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding DataContext.SelectedShopCurrency, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="FL" />
                                                                <Condition Binding="{Binding PriceCoins}" Value="{x:Null}" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Stock, StringFormat=Осталось: {0}}" Style="{StaticResource Text.Caption}"
                                                   Visibility="{Binding Limited, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Button.Primary.Small}" Content="Картой"
                                            MinWidth="82" MinHeight="30" Padding="8,3"
                                                ToolTip="Оплатить картой в UAH"
                                                IsEnabled="{Binding DataContext.CanPurchaseShopItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Command="{Binding DataContext.BuyShopItemCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Button.Secondary}" MinWidth="82" MinHeight="30" Padding="8,3" Margin="0,4,0,0"
                                            Content="USDT" ToolTip="Оплатить криптовалютой USDT"
                                                IsEnabled="{Binding DataContext.CanPurchaseShopItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Command="{Binding DataContext.BuyShopItemCryptoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Button.Secondary}" MinWidth="82" MinHeight="30" Padding="8,3" Margin="0,4,0,0"
                                            Content="FL Coins" ToolTip="Купить за внутреннюю валюту"
                                            IsEnabled="{Binding DataContext.CanPurchaseShopItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Command="{Binding DataContext.BuyShopItemCoinsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Button.Ghost}" MinWidth="82" MinHeight="30" Padding="8,3" Margin="0,4,0,0"
                                            Content="Открыть кейс" ToolTip="Открытие с серверным выбором результата"
                                            Visibility="{Binding Type, Converter={StaticResource Eq}, ConverterParameter=case}"
                                            Command="{Binding DataContext.OpenShopCaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Background="{DynamicResource Brush.Bg1}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="16" Panel.ZIndex="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding VisibleShopItems.Count}" Value="0" />
                                    <Condition Binding="{Binding IsShopBusy}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="24">
                    <Border Width="96" Height="96" CornerRadius="48" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72E;" FontSize="30"
                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Магазин пока недоступен" Style="{StaticResource Text.H3}"
                               HorizontalAlignment="Center" Margin="0,18,0,6" />
                    <TextBlock Text="{Binding ShopEmptyMessage}" Style="{StaticResource Text.Small}"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Style="{StaticResource Button.Primary}" Content="Повторить"
                            Command="{Binding NavigateCommand}" CommandParameter="Shop"
                            MinWidth="150" Margin="0,18,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>