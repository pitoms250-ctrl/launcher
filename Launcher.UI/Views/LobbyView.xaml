<UserControl x:Class="Launcher.UI.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Launcher.UI.Views"
             Foreground="{DynamicResource Brush.TextPrimary}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid ClipToBounds="True">
        <Image Source="/Assets/hero.jpg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#B006170F" Offset="0" />
                    <GradientStop Color="#350B2115" Offset="0.48" />
                    <GradientStop Color="#D507130D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border VerticalAlignment="Bottom" Height="260">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00040D0A" Offset="0" />
                    <GradientStop Color="#B8040D0A" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="8,4,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="F LAUNCHER  /  LOBBY" Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Accent400}" FontWeight="Bold" />
                    <TextBlock Text="Твой мир начинается здесь" FontFamily="{DynamicResource Font.Display}"
                               FontSize="23" FontWeight="Bold" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Badge}" Padding="12,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Success}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding TotalPlayers, StringFormat={}{0} игроков онлайн}"
                                   Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,8,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="164" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="196" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Style="{StaticResource Button.Ghost}" Padding="0" MinHeight="0" Height="76"
                            Margin="0,0,0,9" Command="{Binding NavigateCommand}" CommandParameter="Shop">
                        <Border CornerRadius="10" BorderBrush="#70FFFFFF" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Image Source="/Assets/hero.jpg" Stretch="UniformToFill" />
                                <Border Background="#A000100A" />
                                <StackPanel VerticalAlignment="Bottom" Margin="10,7">
                                    <TextBlock Text="МАГАЗИН" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Text="Образы и наборы" Style="{StaticResource Text.Caption}"
                                               Foreground="#D7EBDD" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                    <Button Style="{StaticResource Button.Ghost}" Padding="0" MinHeight="0" Height="76"
                            Margin="0,0,0,9" Command="{Binding NavigateCommand}" CommandParameter="Skins">
                        <Border CornerRadius="10" BorderBrush="#70FFFFFF" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Image Source="/imge/deco-island.png" Stretch="UniformToFill" />
                                <Border Background="#A000100A" />
                                <StackPanel VerticalAlignment="Bottom" Margin="10,7">
                                    <TextBlock Text="МОЙ СКИН" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Text="Настроить персонажа" Style="{StaticResource Text.Caption}"
                                               Foreground="#D7EBDD" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                    <Button Style="{StaticResource Button.Ghost}" Padding="0" MinHeight="0" Height="76"
                            Command="{Binding NavigateCommand}" CommandParameter="Online">
                        <Border CornerRadius="10" BorderBrush="#70FFFFFF" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Image Source="/Assets/explore.jpg" Stretch="UniformToFill" />
                                <Border Background="#A000100A" />
                                <StackPanel VerticalAlignment="Bottom" Margin="10,7">
                                    <TextBlock Text="СЕРВЕРЫ" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Text="Играть с друзьями" Style="{StaticResource Text.Caption}"
                                               Foreground="#D7EBDD" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                </StackPanel>

                <Grid Grid.Column="1" ClipToBounds="False">
                    <Ellipse Width="310" Height="46" Fill="#7005110B" VerticalAlignment="Bottom"
                             HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Ellipse.Effect>
                            <BlurEffect Radius="18" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <v:SkinLobbyView Skin="{Binding PlayerSkin}" Width="430" Height="430"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"
                                IsHitTestVisible="False">
                        <TextBlock Text="{Binding ProfileDisplayName}" FontFamily="{DynamicResource Font.Display}"
                                   FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ProfileAccountStatus}" Style="{StaticResource Text.Caption}"
                                   Foreground="#D2E4D8" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Column="2" VerticalAlignment="Center" Background="#C8081A12"
                        BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="МИРЫ" Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Accent400}" FontWeight="Bold" />
                        <TextBlock Text="Сейчас играют" FontFamily="{DynamicResource Font.Display}"
                                   FontSize="16" FontWeight="Bold" Margin="0,3,0,9" />
                        <ItemsControl ItemsSource="{Binding Servers}" MaxHeight="170">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.Ghost}" Padding="0" MinHeight="0"
                                            Margin="0,0,0,7"
                                            Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Motd}" Style="{StaticResource Text.Caption}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Players}"
                                                       Foreground="{DynamicResource Brush.Accent400}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding JavaStatus}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#E807160F" BorderBrush="#70FFFFFF"
                    BorderThickness="1" CornerRadius="12" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="8" Background="#224ADE80"
                            BorderBrush="#55FFFFFF" BorderThickness="1">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7C1;" FontSize="23"
                                   Foreground="{DynamicResource Brush.Accent400}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                        <TextBlock Text="ГОТОВ К ИГРЕ" Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Accent400}" FontWeight="Bold" />
                        <ComboBox ItemsSource="{Binding VersionList}" SelectedItem="{Binding SelectedVersion}"
                                  DisplayMemberPath="Id" Style="{StaticResource ComboBox.Themed}"
                                  MinWidth="170" HorizontalAlignment="Left" Margin="0,3,0,0"
                                  ToolTip="Выбрать версию Minecraft" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding ProgressText}" Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="3" Style="{StaticResource Button.Primary.Play}" Command="{Binding PlayCommand}"
                            MinWidth="158" MinHeight="54" Padding="20,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="18"
                                       Margin="0,0,9,0" />
                            <TextBlock Text="ИГРАТЬ" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>